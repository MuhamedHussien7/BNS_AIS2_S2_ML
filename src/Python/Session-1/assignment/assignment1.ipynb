    "text = \"###!!@mocleW EPGTQ!!!6789\"\n",
    "core_part = text.lstrip(\"###!!@\").rstrip(\"!6789\")\n",
    "word1, word2 = core_part.split()\n",
    "word1_reversed = word1[::-1]\n",
    "new_word1 = word1_reversed.replace(\"Welcom\",\"Welcome\")\n",
    "new_word2 = word2.replace( \"E\" , \"\" )\n",
    "result = new_word1 + \" \" + new_word2\n",
    "result"
   ]
